# ── Discord ────────────────────────────────────────────────────────────────
TOKEN=your-bot-token

# Channel receiving the live admin action feed
ADMIN_LOG_CHANNEL=

# Optional second channel for critical + staff events only
ADMIN_ALERT_CHANNEL=

# Per-server feed overrides (optional; falls back to ADMIN_LOG_CHANNEL)
# ADMIN_LOG_CHANNEL_EU=
# ADMIN_LOG_CHANNEL_AU=

# ── Permissions ────────────────────────────────────────────────────────────
# Role allowed to run !hammer1 / !hammer0
HAMMER_ROLE_ID=1481437074870632662

# ── Servers ────────────────────────────────────────────────────────────────
# A server is watched only when all three RCON vars are set.
# GUILD_ID maps a Discord to a server so !hammer knows which console to hit.
EU_GUILD_ID=
EU_RCON_HOST=
EU_RCON_PORT=
EU_RCON_PASSWORD=

# AU_GUILD_ID=
# AU_RCON_HOST=
# AU_RCON_PORT=
# AU_RCON_PASSWORD=

# Also supported: EU_2X_*, AU_2X_*, EU_3X_*, AU_3X_*

# ── Logging behaviour ──────────────────────────────────────────────────────
# The admin roster is read from the server itself via `getauthlevels`, so it
# needs no configuration and stays correct through renames and staff changes.
#
# This adds EXTRA names/SteamID64s on top of what the server reports — for
# staff who hold no in-game auth level. Everyone is logged either way; this
# only controls the 👁️ flag and alert routing.
# ADMIN_LOG_WATCHLIST=SomeName,76561198000000000

# How often to re-read the roster, in ms (default 15 min).
# ADMIN_ROSTER_REFRESH_MS=900000

# Minimum severity mirrored to Discord (0=everything, 1=skip routine noise).
# Disk audit trail always records everything regardless of this.
# ADMIN_LOG_MIN_RANK=0

# Log ONLY admin/mod/owner actions, discarding ordinary player activity.
# Defaults to true. Set to false to record everyone again.
#
# Caveat: staff are matched against the `getauthlevels` roster. When that
# roster reports names without SteamIDs, matching is by name — so a staff
# member who renames is not recognised until the next roster refresh, and
# their actions are dropped rather than merely unflagged in the meantime.
# Adding their SteamID64s to ADMIN_LOG_WATCHLIST above avoids this.
# ADMIN_LOG_STAFF_ONLY=true
