# Copy this file to ".env" and fill it in. Never commit ".env".
#
# Each bot MUST have its own token. Two processes sharing one token both
# receive every interaction and both rewrite the same data files, which is
# what made tickets roll back and Close fail. start-all.mjs refuses to start
# if it finds a duplicate.

# Developer Portal → Bot → Reset Token
DISCORD_TOKEN=

# Developer Portal → General Information → Application ID
CLIENT_ID=

# Optional. Set it and slash commands deploy to that one guild instantly;
# leave it blank to deploy globally, which can take up to an hour to appear.
GUILD_ID=

# Optional. Only needed for the AI auto-translate feature; the bot runs
# without it, with translation disabled.
OPENROUTER_API_KEY=
